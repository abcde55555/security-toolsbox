{
  "name": "en18031-tools",
  "version": "0.1.0",
  "private": true,
  "description": "EN18031 合规测试平台",
  "scripts": {
    "build": "pnpm -r --filter=./packages/** run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "dev:server": "pnpm --filter @en18031/server run dev",
    "dev:web": "pnpm --filter @en18031/web run dev",
    "seed": "pnpm --filter @en18031/server run seed",
    "start": "pnpm --filter @en18031/server run start"
  },
  "engines": {
    "node": ">=18"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  },
  "devDependencies": {
    "playwright-core": "^1.62.1"
  }
}
